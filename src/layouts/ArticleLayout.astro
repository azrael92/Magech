---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  deck?: string;
  meta?: string[]; // pre-formatted strings to join with separators
  activeSection?: 'overview' | 'negative-space' | 'projects' | null;
  opensWith?: 'drop_cap' | 'image' | 'pullquote';
  authoredBy?: string;
  reviewedBy?: string | null;
  embedUrl?: string | null;
  embedNote?: string | null;
}
const { title, deck, meta = [], activeSection = null, opensWith, authoredBy, reviewedBy, embedUrl, embedNote } = Astro.props;
const brandify = (name: string) => name.replace('MESH', '<span class="brand-accent">MESH</span>');
const bodyClass = opensWith === 'drop_cap' ? 'essay-body drop-cap' : 'essay-body';
const isVideo = embedUrl ? /\.(webm|mp4|ogg)$/i.test(embedUrl) : false;
---
<BaseLayout title={`${title} · Magech`} activeSection={activeSection}>
  <section class="essay">
    <article class="essay-inner">
      {meta.length > 0 && (
        <div class="essay-meta">
          {meta.map((m, i) => (
            <>
              {i > 0 && <span class="sep">·</span>}
              <span>{m}</span>
            </>
          ))}
        </div>
      )}
      <h1 class="essay-title" set:html={brandify(title)} />
      {deck && <p class="essay-deck">{deck}</p>}
      {embedUrl ? (
        <div class="project-embed">
          {embedNote && <p class="project-embed-note">{embedNote}</p>}
          <div class="project-embed-frame">
            {isVideo ? (
              <video
                src={embedUrl}
                controls
                loop
                muted
                autoplay
                playsinline
                style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:top;background:#0a0908;display:block;"
              />
            ) : (
              <iframe
                src={embedUrl}
                title={`${title} — live demo`}
                allow="fullscreen"
              />
            )}
          </div>
        </div>
      ) : embedNote ? (
        <div class="project-embed project-embed--pending">
          <p class="project-embed-note">{embedNote}</p>
        </div>
      ) : null}
      <div class={bodyClass}>
        <slot />
      </div>
      {(authoredBy || reviewedBy) && (
        <hr />
      )}
      {(authoredBy || reviewedBy) && (
        <div class="essay-meta" style="margin: 0;">
          {authoredBy && <span>Authored by {authoredBy}</span>}
          {authoredBy && reviewedBy && <span class="sep">·</span>}
          {reviewedBy && <span>Reviewed by {reviewedBy === 'rishi' ? 'R.S.' : reviewedBy}</span>}
        </div>
      )}
    </article>
  </section>
</BaseLayout>
