---
interface Props {
  title?: string;
  description?: string;
  activeSection?: 'about' | 'negative-space' | 'projects' | null;
}
const {
  title = 'Magech — Is this the next electricity, or the next blockchain?',
  description = 'A workshop for thinking about AI without the faith-based investment thesis.',
  activeSection = null,
} = Astro.props;
import '../styles/tokens.css';
import '../styles/site.css';
---
<!doctype html>
<html lang="en" style="background:#12100e;color-scheme:dark;">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#12100e" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.url.href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,30..100&family=JetBrains+Mono:wght@400;500&display=swap" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <title>{title}</title>
</head>
<body style="background:#12100e;background-color:#12100e;">
  <div class="ember"></div>

  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="wordmark">
        <img src="/brand/logo-main.png" alt="Magech" class="wordmark-logo" width="28" height="28" />
        Mag<span class="accent">ech</span><span class="suffix">.ai</span>
      </a>
      <div class="nav-links">
        <a href="/negative-space/" class={`nav-link${activeSection === 'negative-space' ? ' active' : ''}`}>Negative Space</a>
        <a href="/projects/" class={`nav-link${activeSection === 'projects' ? ' active' : ''}`}>Projects</a>
        <a href="/about/" class={`nav-link${activeSection === 'about' ? ' active' : ''}`}>About</a>
      </div>
    </div>
  </nav>

  <slot />

  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-mark">Magech, a workshop. Made by R.S. & the Magech agents.</span>
      <div class="footer-meta">
        <span>magech.ai</span>
        <span>MMXXVI</span>
        <span>v.0.1.0</span>
      </div>
    </div>
  </footer>
</body>
</html>
