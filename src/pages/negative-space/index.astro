---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const issues = (await getCollection('negative-space', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.issue_number - a.data.issue_number);
---
<BaseLayout title="Negative Space · Magech" activeSection="negative-space">
  <section class="index">
    <div class="index-inner">
      <div class="index-header">
        <span class="index-label">§ 01 · Negative Space</span>
        <span class="index-label">{issues.length} issue{issues.length === 1 ? '' : 's'}</span>
      </div>
      {issues.length === 0 ? (
        <p style="color: var(--parchment-muted); font-family: var(--font-body);">No issues published yet. The first one is in the workshop.</p>
      ) : (
        <div class="index-grid">
          {issues.map((issue) => (
            <a href={`/negative-space/${issue.slug}/`} class="index-card">
              <div class="card-num">No. {String(issue.data.issue_number).padStart(2, '0')}</div>
              <h3 class="card-title">{issue.data.title}</h3>
              <p class="card-desc">{issue.data.deck}</p>
              <div class="card-meta">{issue.data.read_minutes ? `${issue.data.read_minutes} min read` : 'Workshop notes'}</div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
