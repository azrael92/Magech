---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('research', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.last_updated?.getTime() ?? 0) - (a.data.last_updated?.getTime() ?? 0));

// group by thread_id
const byThread: Record<string, typeof entries> = {};
for (const e of entries) {
  const tid = e.data.thread_id;
  if (!byThread[tid]) byThread[tid] = [];
  byThread[tid].push(e);
}
---
<BaseLayout title="Research · Magech" activeSection="research">
  <section class="index">
    <div class="index-inner">
      <div class="index-header">
        <span class="index-label">§ 02 · Research</span>
        <span class="index-label">{entries.length} entr{entries.length === 1 ? 'y' : 'ies'} · {Object.keys(byThread).length} thread{Object.keys(byThread).length === 1 ? '' : 's'}</span>
      </div>
      {entries.length === 0 ? (
        <p style="color: var(--parchment-muted); font-family: var(--font-body);">No entries yet. Working notes accumulate here.</p>
      ) : (
        <div class="index-grid">
          {entries.map((entry) => (
            <a href={`/research/${entry.slug}/`} class="index-card">
              <div class="card-num">{entry.data.entry_type.toUpperCase()} · {entry.data.thread_id}</div>
              <h3 class="card-title">{entry.data.title}</h3>
              <p class="card-desc">{entry.data.status_summary}</p>
              <div class="card-meta">Updated {entry.data.last_updated.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
