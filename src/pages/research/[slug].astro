---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('research', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const meta = [
  `Research · ${entry.data.entry_type}`,
  entry.data.thread_id ? `Thread: ${entry.data.thread_id}` : null,
  entry.data.last_updated ? `Updated ${entry.data.last_updated.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}` : null,
].filter(Boolean) as string[];
---
<ArticleLayout
  title={entry.data.title}
  meta={meta}
  activeSection="research"
  authoredBy={entry.data.authored_by}
  reviewedBy={entry.data.reviewed_by}
>
  <Content />
</ArticleLayout>
