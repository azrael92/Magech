---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => data.status === 'published'))
  .sort((a, b) => (a.data.sort_order ?? 99) - (b.data.sort_order ?? 99));
---
<BaseLayout title="Projects · Magech" activeSection="projects">
  <section class="index">
    <div class="index-inner">
      <div class="index-header">
        <span class="index-label">§ 02 · Projects</span>
        <span class="index-label">{projects.length} project{projects.length === 1 ? '' : 's'}</span>
      </div>
      <p style="color: var(--parchment); font-family: var(--font-body); font-size: 0.95rem; max-width: 60ch; margin: 1rem 0 2rem 0; line-height: 1.6;">Is this the next electricity, or the next blockchain? A workshop for thinking about AI without the faith-based investment thesis.</p>
      {projects.length === 0 ? (
        <p style="color: var(--parchment-muted); font-family: var(--font-body);">Build log opens with the first write-up.</p>
      ) : (
        <div class="index-grid">
          {projects.map((p) => (
            <a href={`/projects/${p.slug}/`} class="index-card">
              <div class="card-num">{p.data.project_status.toUpperCase()}</div>
              <h3 class="card-title">{p.data.project_name}</h3>
              <p class="card-desc">{p.data.tagline}</p>
              <div class="card-meta">{p.data.stack.slice(0, 4).join(' · ')}</div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
