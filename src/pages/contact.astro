---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact · Magech" activeSection="contact">
  <section class="hero" style="padding: 5rem 0 2rem;">
    <div class="hero-inner">
      <p class="hero-eyebrow">Get in touch</p>
      <h1 class="hero-title" style="font-size: clamp(2rem, 5vw, 3.5rem); max-width: 30ch;">Rishi Samani</h1>
      <p class="hero-sub" style="max-width: 38rem;">Senior PM working on AI/ML products. Building agent systems in personal time. Open to senior product roles where the work is technically grounded.</p>
    </div>
  </section>

  <section class="index" style="border-top: none; padding-top: 2rem;">
    <div class="index-inner">
      <div class="index-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); max-width: 38rem; margin: 0 auto;">
        <a href="https://linkedin.com/in/rishi-samani" class="index-card" target="_blank" rel="noopener noreferrer">
          <div class="card-num">→ LINKEDIN</div>
          <h3 class="card-title">Rishi Samani</h3>
          <p class="card-desc">Resume, role history, recommendations. The right channel for recruiter outreach.</p>
          <div class="card-meta">linkedin.com/in/rishi-samani</div>
        </a>
        <a href="https://github.com/azrael92" class="index-card" target="_blank" rel="noopener noreferrer">
          <div class="card-num">→ GITHUB</div>
          <h3 class="card-title">azrael92</h3>
          <p class="card-desc">Public code, including this site's repo and selected project artifacts.</p>
          <div class="card-meta">github.com/azrael92</div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
