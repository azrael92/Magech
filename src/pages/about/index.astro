---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const pieces = (await getCollection('about', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="About · Magech" activeSection="about">
  <section class="hero" style="padding: 5rem 0 2rem;">
    <div class="hero-inner">
      <p class="hero-eyebrow">About</p>
      <h1 class="hero-title" style="font-size: clamp(2rem, 5vw, 3.5rem); max-width: 30ch;">Rishi Samani</h1>
      <p class="hero-sub" style="max-width: 38rem;">Building agent systems in personal time. Magech is the workshop where the experiments get written up.</p>
    </div>
  </section>

  <section class="essay">
    <article class="essay-inner">
      {pieces.length === 0 ? (
        <p style="color: var(--parchment-muted); font-size: 1.075rem; line-height: 1.7;">The three pieces that live here — <em>whoami</em>, <em>whyamihere</em>, <em>whyarewehere</em> — require a Discord interview with Rishi before any agent can draft them. No synthesis allowed. Check back once the interviews are on the books.</p>
      ) : (
        pieces.map(async (piece) => {
          const { Content } = await piece.render();
          return (
            <>
              <div class="essay-meta">
                <span>§ {String(piece.data.order).padStart(2, '0')} · {piece.data.piece}</span>
                <span class="sep">·</span>
                <span>Last revised {piece.data.last_revised.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
              </div>
              <h2 class="essay-title">{piece.data.title}</h2>
              <div class="essay-body">
                <Content />
              </div>
              <hr />
            </>
          );
        })
      )}
    </article>
  </section>

  <section class="index" style="border-top: none; padding-top: 2rem;">
    <div class="index-inner">
      <div class="index-header">
        <span class="index-label">Elsewhere</span>
      </div>
      <div class="index-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); max-width: 38rem; margin: 0 auto;">
        <a href="https://linkedin.com/in/rishi-samani" class="index-card" target="_blank" rel="noopener noreferrer">
          <div class="card-num">→ LINKEDIN</div>
          <h3 class="card-title">Rishi Samani</h3>
          <p class="card-desc">Work history and professional background.</p>
          <div class="card-meta">linkedin.com/in/rishi-samani</div>
        </a>
        <a href="https://github.com/azrael92" class="index-card" target="_blank" rel="noopener noreferrer">
          <div class="card-num">→ GITHUB</div>
          <h3 class="card-title">azrael92</h3>
          <p class="card-desc">Public code, including this site's repo and selected project artifacts.</p>
          <div class="card-meta">github.com/azrael92</div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
